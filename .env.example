# CompIntel Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env (it is in .gitignore).
# This file contains NAMES only — no values (R-SC-02).

# ---- Application ----------------------------------------------------------
# Environment: local | preview | production
APP_ENV=local

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Database (PostgreSQL) ------------------------------------------------
# Used in Phase 3+ for consent, contributions and audit log.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/compintel

# ---- Data paths (override defaults if needed) -----------------------------
# RAW_DATA_DIR=data/raw
# STAGED_DATA_DIR=data/staged
# CANONICAL_DATA_DIR=data/canonical
# FEATURES_DIR=data/features
# REFERENCE_DIR=data/reference

# ---- Model artifacts ------------------------------------------------------
# ARTIFACTS_DIR=artifacts

# ---- API ------------------------------------------------------------------
# SECRET_KEY is required for any session/token use in beta+
# SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(32))">

# ---- Serving --------------------------------------------------------------
# CHAMPION_MODEL_VERSION=latest
# THRESHOLDS_PATH=config/thresholds.yaml

# ---- Data sources (add one block per licensed source) --------------------
# SOURCE_PLFS_API_KEY=
# SOURCE_BLS_API_KEY=

# ---- Monitoring (Phase 9+) -----------------------------------------------
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Frontend (Phase 9+) -------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8000
