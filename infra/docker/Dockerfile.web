# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------------
# CompIntel Web Client & Reverse Proxy — Production Multi-Stage Dockerfile (T9.14a)
# -----------------------------------------------------------------------------
# Stage 1: Build React 18 / TypeScript SPA
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency definitions and lockfile from apps/web
COPY apps/web/package.json apps/web/package-lock.json ./

# Clean installation of dependencies
RUN npm ci

# Copy web source tree
COPY apps/web/ ./

# Compile TypeScript and build production bundle with Vite
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: Minimal hardened Nginx runtime
FROM nginx:1.27-alpine AS runtime

# Remove default nginx boilerplate
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy reverse proxy and security headers configuration
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Container healthcheck testing root path response
HEALTHCHECK --interval=10s --timeout=5s --start-period=3s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
