# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------------
# CompIntel Serving & Governance API — Production Multi-Stage Dockerfile (T9.14a)
# -----------------------------------------------------------------------------
# Stage 1: Build virtual environment using uv
FROM python:3.12-slim-bookworm AS builder

# Install uv for deterministic package installation
COPY --from=ghcr.io/astral-sh/uv:0.5.21 /uv /bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Copy dependency definition files
COPY pyproject.toml uv.lock README.md ./

# Install production dependencies only into /app/.venv
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

# Copy package source tree and install the project package itself
COPY src/ src/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# -----------------------------------------------------------------------------
# Stage 2: Minimal runtime image
FROM python:3.12-slim-bookworm AS runtime

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Security: Create non-root system user and group (ASVS 14.2.1)
RUN groupadd -g 10001 compintel && \
    useradd -u 10001 -g compintel -m -s /bin/bash compintel

WORKDIR /app

# Copy virtual environment and project from builder
COPY --from=builder --chown=compintel:compintel /app/.venv /app/.venv
COPY --from=builder --chown=compintel:compintel /app/src /app/src

# Copy model artifacts, configs, and database migrations
COPY --chown=compintel:compintel artifacts/ artifacts/
COPY --chown=compintel:compintel config/ config/
COPY --chown=compintel:compintel alembic/ alembic/
COPY --chown=compintel:compintel alembic.ini ./

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app/src" \
    PORT=8000 \
    HOST=0.0.0.0

USER compintel

EXPOSE 8000

# Container healthcheck monitoring /livez
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/livez || exit 1

# Launch production serving application via Uvicorn
CMD ["python", "-m", "uvicorn", "compintel.serving.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
